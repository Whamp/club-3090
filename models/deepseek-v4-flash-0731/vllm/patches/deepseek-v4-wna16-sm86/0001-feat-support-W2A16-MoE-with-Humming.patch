+    monkeypatch.setattr(moe_wna16, "get_tensor_model_parallel_rank", lambda: 0)
+    loader = MoeWNA16Method.get_weight_loader(layer, original_loader)
+
+    assert loader(
+        torch.nn.Parameter(torch.empty(0)),
