# deepseek-v4-request-clocks.service — active-request SM clock lock
# ---------------------------------------------------------------------------
# Install the controller and unit:
#
#   sudo install -Dm755 scripts/deepseek-v4-request-clocks.py \
#     /usr/local/libexec/club-3090/deepseek-v4-request-clocks
#   sudo install -Dm644 scripts/systemd/deepseek-v4-request-clocks.service \
#     /etc/systemd/system/deepseek-v4-request-clocks.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now deepseek-v4-request-clocks.service
#
# Override DEEPSEEK_V4_SLOTS_URL when the service does not bind localhost:
#
#   sudo install -Dm644 /dev/stdin \
#     /etc/club-3090/deepseek-v4-request-clocks.env <<'EOF'
#   DEEPSEEK_V4_SLOTS_URL=http://TAILNET_ADDRESS:8033/slots
#   EOF
#
# The controller resets clocks on idle, endpoint failure, signal, and normal
# exit. It requires root because nvidia-smi -lgc/-rgc are privileged.

[Unit]
Description=club-3090 DeepSeek V4 request-aware GPU clocks
After=docker.service network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service

[Service]
Type=simple
Environment=DEEPSEEK_V4_SLOTS_URL=http://127.0.0.1:8033/slots
Environment=DEEPSEEK_V4_CLOCK_MHZ=1995
EnvironmentFile=-/etc/club-3090/deepseek-v4-request-clocks.env
ExecStart=/usr/local/libexec/club-3090/deepseek-v4-request-clocks --slots-url ${DEEPSEEK_V4_SLOTS_URL} --clock-mhz ${DEEPSEEK_V4_CLOCK_MHZ}
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
